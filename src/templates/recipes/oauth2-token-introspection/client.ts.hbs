export const OAUTH2_TOKEN_INTROSPECTION_OPTIONS = Symbol('OAUTH2_TOKEN_INTROSPECTION_OPTIONS');

/** Supply only from validated deployment configuration, never request input. */
export interface OAuth2TokenIntrospectionOptions {
  introspectionUrl: string;
  requestHeaders?: Readonly<Record<string, string>>;
  timeoutMs?: number;
  maxResponseBytes?: number;
  maxTokenBytes?: number;
  /** Explicit opt-in for a verified private HTTP endpoint (for example K3s service DNS). */
  trustedInternalHttp?: boolean;
  /** Provider-neutral Fetch seam; must honor the supplied URL, signal and redirect policy. */
  transport?: (url: string, init: RequestInit) => Promise<Response>;
}

/** Evidence, never an authorization grant. Optional RFC7662 claims remain optional. */
export interface OAuth2TokenEvidence {
  readonly active: true;
  readonly issuer?: string;
  readonly subject?: string;
  readonly clientId?: string;
  readonly audiences: readonly string[];
  readonly scopes: readonly string[];
  readonly expiresAt?: number;
  readonly issuedAt?: number;
  readonly notBefore?: number;
  readonly tokenType?: string;
  readonly tokenUse?: string;
  readonly extensions: Readonly<Record<string, unknown>>;
  readonly claims: Readonly<Record<string, unknown>>;
}

/** The consumer owns provider profile, session, canonical identity and domain admission. */
export interface OAuth2TokenValidationPolicy<Principal> {
  validate(evidence: OAuth2TokenEvidence): Principal | Promise<Principal>;
}

export class InvalidOAuth2TokenError extends Error {
  constructor(readonly reason: 'invalid_token' | 'inactive_token' | 'policy_rejected') {
    super('Access token rejected');
    this.name = 'InvalidOAuth2TokenError';
  }
}

export class OAuth2IntrospectionUnavailableError extends Error {
  constructor(
    readonly reason: 'timeout' | 'network' | 'http' | 'invalid_response' | 'policy_failure',
  ) {
    super('Token validation unavailable');
    this.name = 'OAuth2IntrospectionUnavailableError';
  }
}

function bounded(value: number | undefined, fallback: number, min: number, max: number): number {
  const result = value ?? fallback;
  if (!Number.isSafeInteger(result) || result < min || result > max) {
    throw new Error('Invalid introspection configuration');
  }
  return result;
}

function record(value: unknown): value is Record<string, unknown> {
  return value !== null && typeof value === 'object' && !Array.isArray(value);
}

function freeze(value: unknown, depth = 0): void {
  if (depth > 32) throw new OAuth2IntrospectionUnavailableError('invalid_response');
  if (value !== null && typeof value === 'object') {
    for (const child of Object.values(value)) freeze(child, depth + 1);
    Object.freeze(value);
  }
}

function optionalString(claims: Record<string, unknown>, key: string): string | undefined {
  const value = claims[key];
  if (value === undefined) return undefined;
  if (typeof value !== 'string' || value.length === 0 || /[\x00-\x1f\x7f]/.test(value)) {
    throw new OAuth2IntrospectionUnavailableError('invalid_response');
  }
  return value;
}

function optionalTime(claims: Record<string, unknown>, key: string): number | undefined {
  const value = claims[key];
  if (value === undefined) return undefined;
  if (typeof value !== 'number' || !Number.isSafeInteger(value) || value < 0) {
    throw new OAuth2IntrospectionUnavailableError('invalid_response');
  }
  return value;
}

function evidence(claims: unknown): OAuth2TokenEvidence {
  if (!record(claims) || typeof claims['active'] !== 'boolean') {
    throw new OAuth2IntrospectionUnavailableError('invalid_response');
  }
  if (!claims['active']) throw new InvalidOAuth2TokenError('inactive_token');
  const aud = claims['aud'];
  const audiences = typeof aud === 'string' ? [aud] : aud === undefined ? [] : aud;
  if (
    !Array.isArray(audiences) ||
    audiences.some(
      (item) => typeof item !== 'string' || item.length === 0 || /[\x00-\x1f\x7f]/.test(item),
    )
  ) {
    throw new OAuth2IntrospectionUnavailableError('invalid_response');
  }
  const scope = claims['scope'];
  if (scope !== undefined && (typeof scope !== 'string' || /[\x00-\x1f\x7f]/.test(scope))) {
    throw new OAuth2IntrospectionUnavailableError('invalid_response');
  }
  if (claims['ext'] !== undefined && !record(claims['ext'])) {
    throw new OAuth2IntrospectionUnavailableError('invalid_response');
  }
  const result: OAuth2TokenEvidence = {
    active: true,
    issuer: optionalString(claims, 'iss'),
    subject: optionalString(claims, 'sub'),
    clientId: optionalString(claims, 'client_id'),
    audiences: Object.freeze([...audiences]),
    scopes: Object.freeze(
      scope === undefined ? [] : [...new Set(scope.split(' ').filter(Boolean))],
    ),
    expiresAt: optionalTime(claims, 'exp'),
    issuedAt: optionalTime(claims, 'iat'),
    notBefore: optionalTime(claims, 'nbf'),
    tokenType: optionalString(claims, 'token_type'),
    tokenUse: optionalString(claims, 'token_use'),
    extensions: (claims['ext'] as Record<string, unknown> | undefined) ?? {},
    claims,
  };
  freeze(result);
  return result;
}

export class OAuth2TokenIntrospectionClient {
  private readonly url: string;
  private readonly headers: Readonly<Record<string, string>>;
  private readonly timeoutMs: number;
  private readonly maxResponseBytes: number;
  private readonly maxTokenBytes: number;
  private readonly transport: (url: string, init: RequestInit) => Promise<Response>;

  constructor(options: OAuth2TokenIntrospectionOptions) {
    try {
      const url = new URL(options.introspectionUrl);
      if (
        url.username ||
        url.password ||
        url.hash ||
        url.search ||
        (url.protocol !== 'https:' &&
          !(url.protocol === 'http:' && options.trustedInternalHttp === true))
      ) {
        throw new Error();
      }
      this.url = url.href;
      const headers = new Headers({
        accept: 'application/json',
        'content-type': 'application/x-www-form-urlencoded',
      });
      for (const [key, value] of Object.entries(options.requestHeaders ?? {})) {
        if (['accept', 'content-type'].includes(key.toLowerCase())) throw new Error();
        headers.set(key, value);
      }
      this.headers = Object.freeze(Object.fromEntries(headers.entries()));
      this.timeoutMs = bounded(options.timeoutMs, 3000, 10, 30000);
      this.maxResponseBytes = bounded(options.maxResponseBytes, 65536, 128, 1048576);
      this.maxTokenBytes = bounded(options.maxTokenBytes, 16384, 1, 65536);
      this.transport = options.transport ?? ((url, init) => fetch(url, init));
    } catch {
      throw new Error('Invalid introspection configuration');
    }
  }

  async introspect(token: string): Promise<OAuth2TokenEvidence> {
    if (
      typeof token !== 'string' ||
      token.length === 0 ||
      token.length > this.maxTokenBytes ||
      /[^\x21-\x7e]/.test(token)
    ) {
      throw new InvalidOAuth2TokenError('invalid_token');
    }
    const abort = new AbortController();
    let timer: ReturnType<typeof setTimeout> | undefined;
    const timeout = new Promise<never>((_, reject) => {
      timer = setTimeout(() => {
        abort.abort();
        reject(new OAuth2IntrospectionUnavailableError('timeout'));
      }, this.timeoutMs);
    });
    try {
      return await Promise.race([this.request(token, abort.signal), timeout]);
    } catch (error) {
      if (
        error instanceof InvalidOAuth2TokenError ||
        error instanceof OAuth2IntrospectionUnavailableError
      )
        throw error;
      throw new OAuth2IntrospectionUnavailableError('network');
    } finally {
      clearTimeout(timer);
      abort.abort();
    }
  }

  async validate<Principal>(
    token: string,
    policy: OAuth2TokenValidationPolicy<Principal>,
  ): Promise<Principal> {
    const verifiedEvidence = await this.introspect(token);
    try {
      return await policy.validate(verifiedEvidence);
    } catch (error) {
      if (
        error instanceof InvalidOAuth2TokenError ||
        error instanceof OAuth2IntrospectionUnavailableError
      )
        throw error;
      throw new OAuth2IntrospectionUnavailableError('policy_failure');
    }
  }

  private async request(token: string, signal: AbortSignal): Promise<OAuth2TokenEvidence> {
    const response = await this.transport(this.url, {
      method: 'POST',
      headers: { ...this.headers },
      body: new URLSearchParams({ token, token_type_hint: 'access_token' }).toString(),
      redirect: 'error',
      cache: 'no-store',
      signal,
    });
    if (!response.ok || response.redirected) {
      void response.body?.cancel().catch(() => undefined);
      throw new OAuth2IntrospectionUnavailableError('http');
    }
    if (signal.aborted) {
      void response.body?.cancel().catch(() => undefined);
      throw new OAuth2IntrospectionUnavailableError('timeout');
    }
    const length = response.headers.get('content-length');
    if (length !== null && (!/^\d+$/.test(length) || Number(length) > this.maxResponseBytes)) {
      void response.body?.cancel().catch(() => undefined);
      throw new OAuth2IntrospectionUnavailableError('invalid_response');
    }
    if (!response.body) throw new OAuth2IntrospectionUnavailableError('invalid_response');
    const reader = response.body.getReader();
    const cancel = () => {
      void reader.cancel().catch(() => undefined);
    };
    signal.addEventListener('abort', cancel, { once: true });
    const chunks: Uint8Array[] = [];
    let size = 0;
    try {
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        size += value.byteLength;
        if (size > this.maxResponseBytes)
          throw new OAuth2IntrospectionUnavailableError('invalid_response');
        chunks.push(value);
      }
      const bytes = new Uint8Array(size);
      let offset = 0;
      for (const chunk of chunks) {
        bytes.set(chunk, offset);
        offset += chunk.byteLength;
      }
      try {
        return evidence(JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(bytes)));
      } catch (error) {
        if (
          error instanceof InvalidOAuth2TokenError ||
          error instanceof OAuth2IntrospectionUnavailableError
        )
          throw error;
        throw new OAuth2IntrospectionUnavailableError('invalid_response');
      }
    } finally {
      signal.removeEventListener('abort', cancel);
      void reader.cancel().catch(() => undefined);
      reader.releaseLock();
    }
  }
}
